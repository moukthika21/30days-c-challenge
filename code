#include <stdio.h>

int main() {
    int a[12];                       // array for the readings (N <= 12)
    int n, i, j, s, k, shift, temp;
    int sum = 0, min, max, second = -1;
    int peaks = 0, run = 1, longest = 1;
    int r = 42, d, count = 0;        // r = last 2 digits of reg. number
    float avg;

    // read N and keep asking until it is between 5 and 12
    do {
        printf("Enter number of readings N (5 to 12): ");
        scanf("%d", &n);
        if (n < 5 || n > 12) {
            printf("Invalid N! Enter a value from 5 to 12.\n");
        }
    } while (n < 5 || n > 12);

    // read every reading (0 to 1000), ask again if it is invalid
    for (i = 0; i < n; i++) {
        do {
            printf("Enter reading %d (0 to 1000): ", i + 1);
            scanf("%d", &a[i]);
            if (a[i] < 0 || a[i] > 1000) {
                printf("Invalid reading! Enter 0 to 1000.\n");
            }
        } while (a[i] < 0 || a[i] > 1000);
    }

    // task 1: show the original readings
    printf("\nOriginal readings: ");
    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    printf("\n");

    // task 2: sum, average, minimum and maximum
    min = a[0];
    max = a[0];
    for (i = 0; i < n; i++) {
        sum = sum + a[i];
        if (a[i] < min) min = a[i];
        if (a[i] > max) max = a[i];
    }
    avg = (float) sum / n;
    printf("Sum = %d, Average = %.2f\n", sum, avg);
    printf("Minimum = %d, Maximum = %d\n", min, max);

    // task 3: second-largest DISTINCT value (ignore the maximum)
    for (i = 0; i < n; i++) {
        if (a[i] != max && a[i] > second) {
            second = a[i];
        }
    }
    if (second == -1) {
        printf("No second-largest distinct value.\n");
    } else {
        printf("Second-largest distinct value = %d\n", second);
    }

    // task 4: local peaks (first and last elements are not checked)
    for (i = 1; i < n - 1; i++) {
        if (a[i] > a[i - 1] && a[i] > a[i + 1]) {
            peaks++;
        }
    }
    printf("Local peaks = %d\n", peaks);

    // task 5: longest strictly increasing run
    for (i = 1; i < n; i++) {
        if (a[i] > a[i - 1]) {
            run++;
        } else {
            run = 1;
        }
        if (run > longest) {
            longest = run;
        }
    }
    printf("Longest increasing run = %d\n", longest);

    // task 6: rotate by K without a second array
    printf("Enter K (+ right, - left): ");
    scanf("%d", &k);
    shift = k % n;                   // reduce K to less than n shifts
    if (shift < 0) {
        shift = shift + n;           // left rotation -> right rotation
    }
    for (s = 0; s < shift; s++) {
        temp = a[n - 1];             // save the last element
        for (j = n - 1; j > 0; j--) {
            a[j] = a[j - 1];         // shift one place to the right
        }
        a[0] = temp;
    }
    printf("Array after rotation: ");
    for (i = 0; i < n; i++) {
        printf("%d ", a[i]);
    }
    printf("\n");

    // task 7: personalised divisor D and the count divisible by D
    d = (r % 9) + 1;
    for (i = 0; i < n; i++) {
        if (a[i] % d == 0) {
            count++;
        }
    }
    printf("D = %d, values divisible by D = %d\n", d, count);

    return 0;
}
